{
  "team": {
    "name": "salesflow-demo",
    "version": "0.2.0",
    "description": "Multi-agent autonomous car-sales deal-closing demo for GOAI Agent Infra round.",
    "primary_runtime": "agentteams-real-llm",
    "worker_runtime": "qwenpow(copow/QwenPaw)",
    "creation_policy": {
      "mode": "serial",
      "order": [
        "lead_intake",
        "profile_builder",
        "intent_analyst",
        "strategy_planner",
        "negotiation_executor",
        "order_executor",
        "customer_ops",
        "knowledge_miner",
        "team"
      ],
      "rule": "Create the next business Worker only after the previous Worker is created and verified healthy. During Team creation, manager must create salesflow-demo-leader as a dedicated TeamLeader Worker."
    },
    "team_leader": {
      "id": "salesflow_demo_leader",
      "name": "salesflow-demo-leader",
      "creation": "created by manager during Team creation",
      "rule": "Must be created as a new independent Worker and designated as TeamLeader. Do not designate any business Worker as leader."
    },
    "agent_spec_source": "inline messages in at/create_agents_messages.md",
    "deal_task_source": "three deal messages in at/run_demo_task_message.md",
    "task_submission_policy": {
      "room": "Matrix room whose name starts with Team and matches salesflow-demo",
      "mention": "@<team_leader_name>",
      "rule": "Enter the Team room, mention the team leader, paste one deal task into that mention message, and wait for the report before submitting the next deal."
    },
    "tool_gateway": {
      "transport": "http",
      "base_url": "http://<TOOL_HOST_REACHABLE_BY_WORKER>:18089",
      "call_pattern": "POST /tools/{scenario_id}/{tool_name}.{function_name}"
    }
  },
  "agents": [
    {
      "id": "lead_intake",
      "name": "Lead Intake Agent",
      "inline_spec_section": "at/create_agents_messages.md#复制到-manager-的完整创建请求",
      "local_spec_file": "agents/lead-intake/Agent.md",
      "skills": ["lead-fusion", "profile-building"],
      "tools": ["mock_crm", "mock_wechat", "mock_knowledge"]
    },
    {
      "id": "profile_builder",
      "name": "Profile Builder Agent",
      "inline_spec_section": "at/create_agents_messages.md#复制到-manager-的完整创建请求",
      "local_spec_file": "agents/profile-builder/Agent.md",
      "skills": ["profile-building", "deal-memory"],
      "tools": ["mock_crm", "mock_knowledge"]
    },
    {
      "id": "intent_analyst",
      "name": "Intent Analyst Agent",
      "inline_spec_section": "at/create_agents_messages.md#复制到-manager-的完整创建请求",
      "local_spec_file": "agents/intent-analyst/Agent.md",
      "skills": ["intent-scoring", "deal-memory"],
      "tools": ["mock_crm", "mock_knowledge"]
    },
    {
      "id": "strategy_planner",
      "name": "Strategy Planner Agent",
      "inline_spec_section": "at/create_agents_messages.md#复制到-manager-的完整创建请求",
      "local_spec_file": "agents/strategy-planner/Agent.md",
      "skills": ["car-recommendation", "quote-pricing", "deal-memory"],
      "tools": ["mock_inventory", "mock_price", "mock_knowledge", "mock_crm"]
    },
    {
      "id": "negotiation_executor",
      "name": "Negotiation Executor Agent",
      "inline_spec_section": "at/create_agents_messages.md#复制到-manager-的完整创建请求",
      "local_spec_file": "agents/negotiation-executor/Agent.md",
      "skills": ["quote-pricing", "negotiation-guard", "test-drive-booking", "finance-plan"],
      "tools": ["mock_price", "mock_finance", "mock_testdrive", "mock_crm"]
    },
    {
      "id": "order_executor",
      "name": "Order Executor Agent",
      "inline_spec_section": "at/create_agents_messages.md#复制到-manager-的完整创建请求",
      "local_spec_file": "agents/order-executor/Agent.md",
      "skills": ["order-safe-execute", "deal-memory"],
      "tools": ["mock_inventory", "mock_order", "mock_verify", "mock_price"]
    },
    {
      "id": "customer_ops",
      "name": "Customer Ops Agent",
      "inline_spec_section": "at/create_agents_messages.md#复制到-manager-的完整创建请求",
      "local_spec_file": "agents/customer-ops/Agent.md",
      "skills": ["profile-building", "deal-memory", "case-mining"],
      "tools": ["mock_crm", "mock_wechat", "mock_knowledge"]
    },
    {
      "id": "knowledge_miner",
      "name": "Knowledge Miner Agent",
      "inline_spec_section": "at/create_agents_messages.md#复制到-manager-的完整创建请求",
      "local_spec_file": "agents/knowledge-miner/Agent.md",
      "skills": ["case-mining", "deal-memory"],
      "tools": ["mock_knowledge", "mock_crm"]
    }
  ],
  "workflow": [
    {"step": 1, "agent": "salesflow_demo_leader", "task": "receive_deal_task_extract_deal_id_scenario_id_and_dispatch"},
    {"step": 2, "agent": "lead_intake", "task": "fuse_multi_channel_sessions_and_grade_lead"},
    {"step": 3, "agent": "profile_builder", "task": "build_customer_profile_with_confidence"},
    {"step": 4, "agent": "intent_analyst", "task": "score_intent_and_set_priority"},
    {"step": 5, "agent": "strategy_planner", "task": "generate_recommendation_quote_and_follow_up_path"},
    {"step": 6, "agent": "negotiation_executor", "task": "execute_low_risk_actions_and_handle_approvals"},
    {"step": 7, "agent": "order_executor", "task": "create_order_draft_verify_deal"},
    {"step": 8, "agent": "customer_ops", "task": "after_sales_touch_and_revival_plan_if_applicable"},
    {"step": 9, "agent": "knowledge_miner", "task": "mine_and_save_deal_case"},
    {"step": 10, "agent": "salesflow_demo_leader", "task": "compose_final_deal_report"}
  ],
  "risk_policy": {
    "auto_execute": ["L0", "L1"],
    "approval_only": ["L2", "L3"],
    "escalate_to_human": "concession_limit_reached_or_customer_complaint"
  }
}
