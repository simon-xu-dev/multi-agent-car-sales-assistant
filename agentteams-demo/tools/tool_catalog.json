{
  "transport": "http-mock-tool-gateway",
  "base_url": "http://<TOOL_HOST_REACHABLE_BY_WORKER>:18089",
  "call_pattern": "POST /tools/{scenario_id}/{tool_name}.{function_name}",
  "tools": [
    {
      "name": "mock_crm",
      "kind": "http-mock-adapter",
      "functions": ["get_lead", "list_sessions", "get_customer_history", "update_lead_stage"],
      "future_mcp_mapping": ["crm.lead.query", "crm.lead.stage_update"]
    },
    {
      "name": "mock_inventory",
      "kind": "http-mock-adapter",
      "functions": ["list_models", "check_stock", "reserve_car"],
      "future_mcp_mapping": ["dms.inventory.query", "dms.inventory.reserve"]
    },
    {
      "name": "mock_price",
      "kind": "http-mock-adapter",
      "functions": ["get_policy", "calc_quote", "apply_discount"],
      "future_mcp_mapping": ["pricing.policy.query", "pricing.quote.calc", "pricing.discount.apply"]
    },
    {
      "name": "mock_finance",
      "kind": "http-mock-adapter",
      "functions": ["calc_plan", "submit_approval", "check_approval"],
      "future_mcp_mapping": ["finance.plan.calc", "finance.approval.submit", "finance.approval.query"]
    },
    {
      "name": "mock_testdrive",
      "kind": "http-mock-adapter",
      "functions": ["list_slots", "book_slot", "cancel_booking"],
      "future_mcp_mapping": ["testdrive.slot.query", "testdrive.slot.book", "testdrive.slot.cancel"]
    },
    {
      "name": "mock_order",
      "kind": "http-mock-adapter",
      "functions": ["create_order", "get_order", "rollback_order"],
      "future_mcp_mapping": ["order.create", "order.query", "order.rollback"]
    },
    {
      "name": "mock_knowledge",
      "kind": "http-mock-adapter",
      "functions": ["search_product", "search_sop", "search_case", "save_case"],
      "future_mcp_mapping": ["knowledge.rag.search", "knowledge.case.save"]
    },
    {
      "name": "mock_wechat",
      "kind": "http-mock-adapter",
      "functions": ["get_session", "send_template_message"],
      "future_mcp_mapping": ["wechat.session.query", "wechat.template_message.send"]
    },
    {
      "name": "mock_verify",
      "kind": "http-mock-adapter",
      "functions": ["check_deal"],
      "future_mcp_mapping": ["deal.verify"]
    }
  ]
}
