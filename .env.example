# ---- 百炼(DashScope) 阿里云模型服务 ----
# 配置后 TeamLeader 审批门禁 + strategy_planner 推荐审查由 LLM 自主推理（留空则降级配置驱动，保证可运行）
DASHSCOPE_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# ---- 阿里云 OSS 对象存储（证据归档真调用）----
# 配置后 EvidenceArchiveSkill 真调 OSS REST API（OSS v1 签名）；留空则降级本地 bucket，接口一致
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=carsales-evidence

# ---- 阿里云短信服务（审批告警真调用）----
# 配置后 sms-approval-alert Skill 真调 Dysmsapi SendSms（RPC V1 签名）；留空则降级本地外呼记录，接口一致
# 签名与模板须先在阿里云短信控制台报备审批通过
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=车销智能助手
SMS_TEMPLATE_CODE=SMS_100000001
# demo 审批人手机号（生产从 HR/组织系统查询，不硬编码）
SMS_APPROVER_PHONE=
